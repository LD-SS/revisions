      ],
      "complement": true
     }
    ]
   },
   {
    "id": "s3",
    "titre": "Supprimer un radical au dénominateur",
    "blocs": [
     {
      "type": "texte",
      "contenu": "Quand une fraction contient une racine carrée au dénominateur, on transforme son écriture pour que le dénominateur ne contienne plus de radical : on **multiplie en haut et en bas par cette racine**.",
      "pages": [
       1
      ]
     },
     {
      "type": "formule",
      "latex": "\\dfrac{a}{\\sqrt{b}} = \\dfrac{a}{\\sqrt{b}} \\times \\dfrac{\\sqrt{b}}{\\sqrt{b}} = \\dfrac{a\\sqrt{b}}{b}",
      "legende": "Méthode (car $\\sqrt{b} \\times \\sqrt{b} = b$)",
      "pages": [
       2
      ]
     },
     {
      "type": "exemple",
      "contenu": "$\\dfrac{3}{\\sqrt{5}} = \\dfrac{3}{\\sqrt{5}} \\times \\dfrac{\\sqrt{5}}{\\sqrt{5}} = \\dfrac{3\\sqrt{5}}{5}$",
