       1
      ]
     }
    ]
   },
   {
    "id": "s2",
    "titre": "Les trois identités remarquables",
    "blocs": [
     {
      "type": "formule",
      "latex": "(a + b)^2 = a^2 + 2ab + b^2",
      "legende": "Carré d'une somme",
      "pages": [
       1
      ]
     },
     {
      "type": "exemple",
      "contenu": "$(x + 5)^2 = x^2 + 10x + 25$",
      "pages": [
       1
      ]
     },
     {
      "type": "formule",
      "latex": "(a - b)^2 = a^2 - 2ab + b^2",
      "legende": "Carré d'une différence",
      "pages": [
       1
      ]
     },
     {
      "type": "exemple",
      "contenu": "$(x - 4)^2 = x^2 - 8x + 16$",
      "pages": [
       1
      ]
     },
     {
      "type": "formule",
      "latex": "(a + b)(a - b) = a^2 - b^2",
      "legende": "Différence de deux carrés",
      "pages": [
       1
      ]
     },
     {
      "type": "exemple",
      "contenu": "$(x + 6)(x - 6) = x^2 - 36$",
      "pages": [
       1
      ]
     },
     {
      "type": "piege",
      "contenu": "N'oublie pas le **double produit** : $(a + b)^2 \\neq a^2 + b^2$. Exemple : $(x + 3)^2 = x^2 + 6x + 9$, pas $x^2 + 9$.",
      "pages": [
       1
      ],
      "complement": true
     }
    ]
   },
   {
