       1
      ]
     },
     {
      "type": "piege",
      "contenu": "N'oublie pas le **double produit** : $(a + b)^2 \\neq a^2 + b^2$. Exemple : $(x + 3)^2 = x^2 + 6x + 9$, pas $x^2 + 9$.",
      "complement": true
     }
    ]
