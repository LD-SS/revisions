        "id": "s1",
        "titre": "Définition et vocabulaire",
        "blocs": [
          { "type": "definition", "titre": "Puissance d'un nombre", "contenu": "Pour un réel $a$ et un naturel $n \\geq 1$, la puissance $a^n$ est le produit de $n$ facteurs égaux à $a$ : $a^n = \\underbrace{a \\cdot a \\cdots a}_{n \\text{ facteurs}}$.\n$a$ est la **base**, $n$ est l'**exposant**.", "pages": [1] },
          { "type": "point-cle", "contenu": "Par convention : $a^1 = a$ et $a^0 = 1$ (pour $a \\neq 0$).", "pages": [1] },
          { "type": "formule", "latex": "a^{-n} = \\dfrac{1}{a^{n}}", "legende": "Exposant négatif (avec $a \\neq 0$)", "pages": [2] }
        ]
